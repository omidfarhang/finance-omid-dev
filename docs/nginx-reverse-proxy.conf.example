# Host nginx terminates TLS and proxies to the Docker web container.
# Match APP_PORT from .env / docker compose (default 8080).
# Adjust certificate paths after issuing certs for finance.omid.dev.

upstream finance_omid_dev {
    server 127.0.0.1:8080;
}

server {
    listen 443 ssl http2;
    server_name finance.omid.dev;

    ssl_certificate     /etc/letsencrypt/live/finance.omid.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/finance.omid.dev/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://finance_omid_dev;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

server {
    listen 80;
    server_name finance.omid.dev;
    return 301 https://$host$request_uri;
}
