generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountMemberRole {
  OWNER
  MEMBER
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum RecurringType {
  INCOME
  EXPENSE
}

enum RecurringInterval {
  MONTHLY
}

enum CalendarSystem {
  GREGORIAN
  JALALI
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  displayName  String
  role         UserRole        @default(USER)
  disabledAt   DateTime?
  locale       String?
  timeZone     String?
  calendar     CalendarSystem  @default(JALALI)
  theme        ThemePreference @default(SYSTEM)
  totpSecret   String?
  totpEnabled  Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sessions           Session[]
  pendingLogins      PendingLogin[]
  wallets            Wallet[]
  accountMembers     AccountMember[]
  categories          Category[]
  createdTransactions Transaction[] @relation("TransactionCreator")
  importBatches       ImportBatch[]
  recurringRules      RecurringRule[]
}

model AppSettings {
  id                Int     @id
  registrationOpen  Boolean @default(true)
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts Account[]

  @@index([ownerUserId])
}

model Account {
  id                   String   @id @default(uuid()) @db.Uuid
  walletId             String   @db.Uuid
  wallet               Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  name                 String
  currency             String   @db.Char(3)
  openingBalanceMinor  BigInt
  isShared             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members              AccountMember[]
  transactions         Transaction[]   @relation("TransactionAccount")
  counterTransactions  Transaction[]   @relation("TransactionCounterAccount")
  importBatches        ImportBatch[]

  @@index([walletId])
}

model AccountMember {
  id        String            @id @default(uuid()) @db.Uuid
  accountId String            @db.Uuid
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccountMemberRole
  createdAt DateTime          @default(now())

  @@unique([accountId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PendingLogin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      CategoryKind
  name      String
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]

  @@unique([userId, kind, name])
  @@index([userId])
  @@index([userId, kind])
}

model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  type             TransactionType
  accountId        String          @db.Uuid
  account          Account         @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  counterAccountId String?         @db.Uuid
  counterAccount   Account?        @relation("TransactionCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)
  amountMinor      BigInt
  occurredAt       DateTime
  description      String?
  categoryId       String?         @db.Uuid
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shared           Boolean         @default(false)
  transferGroupId  String?         @db.Uuid
  dedupeKey        String?
  importBatchId    String?         @db.Uuid
  importBatch      ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdByUserId  String          @db.Uuid
  createdBy        User            @relation("TransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([accountId, dedupeKey])
  @@index([accountId, occurredAt])
  @@index([counterAccountId, occurredAt])
  @@index([createdByUserId])
  @@index([transferGroupId])
  @@index([importBatchId])
}

model ImportBatch {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @db.Uuid
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId              String   @db.Uuid
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adapterId              String
  originalFilename       String
  createdCount           Int
  skippedDuplicateCount  Int
  createdAt              DateTime @default(now())

  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([accountId])
}

model RecurringRule {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        RecurringType
  amountMinor BigInt
  currency    String            @db.Char(3)
  description String?
  interval    RecurringInterval @default(MONTHLY)
  anchorDay   Int
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, active])
}
