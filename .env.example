# Shared / Docker Compose deploy (finance.omid.dev)
APP_PORT=8080
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=finance
# Overridden in Compose to use the postgres service hostname; keep in sync for local tools.
DATABASE_URL=postgresql://finance:change-me-strong-password@postgres:5432/finance?schema=public
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://finance.omid.dev
PORT=3000
NODE_ENV=production

# Optional image tag for Compose pulls (default latest). See DEC-018.
# IMAGE_TAG=latest

# PrimeNG 22+ (PrimeUI) — free Community key for eligible personal use: https://primeui.dev
# Injected at web image build time. For production GHCR images, set as GitHub Actions
# secret PRIMENG_LICENSE (not required in server .env when pulling pre-built images).
# For local `docker build` of the web image, export this in the environment.
PRIMENG_LICENSE=

# Local development (pnpm outside Compose) — override in .env or apps/api/.env:
# DATABASE_URL=postgresql://finance:finance@localhost:5432/finance?schema=public
# CORS_ORIGIN=http://localhost:4200
# NODE_ENV=development
# POSTGRES_PASSWORD=finance
